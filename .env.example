# Example environment file for API keys
# Copy this to .env and fill in your actual keys

# Email/SMS
KLAVIYO_API_KEY=your_klaviyo_api_key_here
POSTSCRIPT_API_KEY=your_postscript_api_key_here
# Add other email/SMS providers as needed

# Advertising Platforms
META_ADS_ACCESS_TOKEN=your_meta_ads_access_token_here
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token_here
TIKTOK_ADS_ACCESS_TOKEN=your_tiktok_ads_access_token_here
PINTEREST_ADS_ACCESS_TOKEN=your_pinterest_ads_access_token_here

# Analytics
GOOGLE_ANALYTICS_MEASUREMENT_ID=your_ga4_measurement_id_here
GOOGLE_ANALYTICS_API_SECRET=your_ga4_api_secret_here

# Ecommerce Platform (if applicable)
SHOPIFY_ADMIN_API_ACCESS_TOKEN=your_shopify_admin_api_access_token_here
SHOPIFY_STORE_NAME=your_shopify_store_name_here

# Other tools
# ADD YOUR OWN AS NEEDED